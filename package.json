{
  "name": "overview",
  "version": "0.1.0",
  "description": "Overview - Job & Task Management System",
  "author": "Your Name",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-qr-code": "^2.0.21",
    "react-router-dom": "^7.9.5",
    "react-scripts": "5.0.1",
    "recharts": "^3.3.0",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "cross-env HOST=0.0.0.0 PORT=3000 DANGEROUSLY_DISABLE_HOST_CHECK=true BROWSER=none react-scripts start",
    "dev": "node scripts/start-local-db.js",
    "electron-dev": "concurrently \"npm run start\" \"wait-on http://localhost:3000 && ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron-build": "npm run build && electron .",
    "build": "react-scripts build && node postbuild.js",
    "electron-pack": "npm run build && electron-builder --win --publish never",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "main": "electron-main.js",
  "devDependencies": {
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "electron": "^26.1.0",
    "electron-builder": "^21.2.0",
    "wait-on": "^7.0.0"
  },
  "proxy": "http://127.0.0.1:3001",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.overview.app",
    "productName": "Overview",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "server/**/*",
      "api/**/*",
      "scripts/**/*",
      "electron-main.js",
      "electron-preload.js",
      "load-env.js",
      "node_modules/**/*",
      ".env.example"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": null
    },
    "asar": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overview"
    }
  }
}
