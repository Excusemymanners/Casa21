--
-- Name: profiles Allow authenticated users to read all profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow authenticated users to read all profiles" ON public.profiles FOR SELECT TO authenticated USING (true);


--
-- Name: jobs CEO and Admin can create jobs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can create jobs" ON public.jobs FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: tasks CEO and Admin can create tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can create tasks" ON public.tasks FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: jobs CEO and Admin can delete jobs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can delete jobs" ON public.jobs FOR DELETE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: tasks CEO and Admin can delete tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can delete tasks" ON public.tasks FOR DELETE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: jobs CEO and Admin can insert jobs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can insert jobs" ON public.jobs FOR INSERT TO authenticated WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: tasks CEO and Admin can insert tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can insert tasks" ON public.tasks FOR INSERT TO authenticated WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: tasks CEO and Admin can update all tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can update all tasks" ON public.tasks FOR UPDATE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text])))))) WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: jobs CEO and Admin can update jobs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can update jobs" ON public.jobs FOR UPDATE TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text])))))) WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: tasks CEO and Admin can update tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can update tasks" ON public.tasks FOR UPDATE USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: jobs CEO and Admin can view all jobs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can view all jobs" ON public.jobs FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: tasks CEO and Admin can view all tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can view all tasks" ON public.tasks FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: time_entries CEO and Admin can view all time entries; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "CEO and Admin can view all time entries" ON public.time_entries FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['ceo'::text, 'admin'::text]))))));


--
-- Name: time_entries Employees can add time entries; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Employees can add time entries" ON public.time_entries FOR INSERT WITH CHECK (((user_id = auth.uid()) AND (EXISTS ( SELECT 1
   FROM public.tasks
  WHERE ((tasks.id = time_entries.task_id) AND (tasks.assignee_id = auth.uid()))))));


--
-- Name: tasks Employees can mark tasks as completed; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Employees can mark tasks as completed" ON public.tasks FOR UPDATE USING ((assignee_id = auth.uid())) WITH CHECK (((assignee_id = auth.uid()) AND (status = ANY (ARRAY['in_progress'::text, 'completed'::text]))));


--
-- Name: tasks Employees can update assigned or unassigned tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Employees can update assigned or unassigned tasks" ON public.tasks FOR UPDATE TO authenticated USING (((assigned_to_email = ( SELECT profiles.email
   FROM public.profiles
  WHERE (profiles.id = auth.uid()))) OR (assigned_to_email IS NULL))) WITH CHECK (((assigned_to_email = ( SELECT profiles.email
   FROM public.profiles
  WHERE (profiles.id = auth.uid()))) OR (assigned_to_email IS NULL)));


--
-- Name: tasks Employees can view assigned tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Employees can view assigned tasks" ON public.tasks FOR SELECT USING ((assignee_id = auth.uid()));


--
-- Name: jobs Enable read access for all authenticated users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable read access for all authenticated users" ON public.jobs FOR SELECT TO authenticated USING (true);


--
-- Name: tasks Enable read access for all authenticated users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable read access for all authenticated users" ON public.tasks FOR SELECT TO authenticated USING (true);


--
-- Name: time_entries Users can view own time entries; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view own time entries" ON public.time_entries FOR SELECT USING ((user_id = auth.uid()));


