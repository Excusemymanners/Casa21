FROM node:22-slim

# Install wine and dependencies for Windows executable building
RUN apt-get update && apt-get install -y \
    wine \
    wine32 \
    wine64 \
    git \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy only essential source files
COPY src ./src
COPY api ./api
COPY server ./server
COPY scripts ./scripts
COPY public ./public
COPY migrations ./migrations
COPY electron-main.js .
COPY electron-preload.js .
COPY load-env.js .
COPY postbuild.js .
COPY build ./build

# Build the executable
RUN npm run electron-pack

# Output will be in dist/ directory
