DATABASE_URL=postgres://postgres:128482@localhost:5432/overview
JWT_SECRET=dev_secret
API_PORT=3001
PGSSLMODE=disable
DISABLE_SMTP=false
SEED_USER_EMAIL=admin@admin.com
SEED_USER_FULL_NAME=Admin Test
SEED_USER_ROLE=admin
SEED_USER_PASSWORD=admin123
# Local environment overrides for development
# SMTP real este activ (DISABLE_SMTP=false).
NODE_ENV=development

# -----------------------------
# Nodemailer / SMTP placeholders
# -----------------------------
# Use these when you want to test real sending locally. Replace the values
# (do NOT commit real secrets). For Vercel, add the same variables in the
# Project > Settings > Environment Variables (or use `vercel env add`).

# -- Recommended: SendGrid (SMTP)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=<SENDGRID_API_KEY>
# FROM_EMAIL=you@yourdomain.com
# SMTP_SECURE=false

# -- Alternative: Gmail (use App Passwords; requires 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=overviewview8@gmail.com
SMTP_PASS=trde cetn cfuw qigf
FROM_EMAIL=overviewview8@gmail.com
SMTP_SECURE=false

# -- Alternative: Mailgun / Mailjet / other providers — use the provider's
# -- given SMTP host/port/credentials and set SMTP_SECURE=true for port 465.

# If you'd rather simulate sends instead of configuring SMTP locally, keep
# DISABLE_SMTP=true. To test Ethereal preview in development set DISABLE_SMTP
# to false and leave SMTP_* unset; the API will create an Ethereal account.

# Security: Never commit real secrets. Use Vercel Environment Variables for
# production credentials and set DISABLE_SMTP=false in production only when
# SMTP vars are present.

# Adresa fixă pentru link-ul de login / QR (telefoane din rețea)
LAN_HOST=192.168.1.128
